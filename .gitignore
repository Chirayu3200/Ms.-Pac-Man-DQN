# ---------- Virtual environments ----------
venv/
.venv/
env/
pacman-env/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---------- Training outputs (large, regenerated by running the code) ----------
checkpoints/
checkpoints_*/
logs/
logs_*/
videos/
videos_*/
runs/
*.pt
*.pth
*.onnx

# To share one trained model in the repo, comment out "*.pt" above and
# keep only the file you want, for example:
#   !pretrained/best.pt
# (a trained model is about 7-30 MB; for bigger files consider Git LFS or a GitHub Release)

# ---------- TensorBoard ----------
events.out.tfevents.*
tb/

